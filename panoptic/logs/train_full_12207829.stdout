# LSBATCH: User input
#!/bin/bash
#BSUB -J panoptic_full                        # Job name
#BSUB -o panoptic/logs/train_full_%J.stdout    # Stdout file (%J = job ID)
#BSUB -e panoptic/logs/train_full_%J.stderr    # Stderr file
